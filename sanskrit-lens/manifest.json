{
  "manifest_version": 3,
  "name": "Sanskrit Lens",
  "version": "1.0.0",
  "description": "Highlight any Sanskrit word — meanings, grammar, and Pāṇinian analysis appear in the side panel.",

  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],

  "host_permissions": [
    "https://www.wisdomlib.org/*",
    "https://astadhyayi.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.bundle.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel/index.html"
  },

  "action": {
    "default_title": "Sanskrit Lens — click to open panel"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
